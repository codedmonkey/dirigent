{
    "name": "@codedmonkey/dirigent",
    "license": "FSL-1.1-MIT",
    "private": true,
    "type": "module",
    "devDependencies": {
        "@hotwired/stimulus": "^3.0.0",
        "@symfony/reprise": "^1.5.0",
        "chart.js": "^4.4.7",
        "typescript": "^5.7.2",
        "vite": "^8.4.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": ">=11.16.0",
            "onFail": "error"
        }
    },
    "scripts": {
        "dev": "vite",
        "serve": "vite",
        "build": "tsc --noEmit && vite build --mode development",
        "watch": "vite build --mode development --watch",
        "production": "tsc --noEmit && vite build",
        "lint:static-analysis": "tsc --noEmit"
    }
}
